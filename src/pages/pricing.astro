---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Workflow Playbooks',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Workflow playbooks"
    title="Choose the cleanup pass that matches your library"
    subtitle="Not every folder needs the same treatment. SnapAtlas works best when you run the right operation in the right order."
  />

  <Features3
    title="Common cleanup passes"
    subtitle="Treat these like playbooks you can run on a small scope first, then expand."
    columns={2}
    items={[
      {
        title: 'Quick scan',
        description: 'Use this for a fast first look at folder structure, counts, and obvious organization problems.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Deep scan',
        description: 'Use this when you want fuller metadata extraction and better duplicate detection coverage.',
        icon: 'tabler:scan-eye',
      },
      {
        title: 'Organize by date and location',
        description: 'Establish consistent structure before doing heavier cleanup passes.',
        icon: 'tabler:calendar-stats',
      },
      {
        title: 'Duplicate cleanup',
        description: 'Review exact duplicates first, then visual duplicates, and stage removals for confirmation.',
        icon: 'tabler:copy-check',
      },
      {
        title: 'Folder merge pass',
        description: 'Consolidate related date folders or split import batches after structure is clearer.',
        icon: 'tabler:folders',
      },
      {
        title: 'HEIC conversion pass',
        description: 'Convert only where compatibility matters and verify output before removing anything.',
        icon: 'tabler:transform-point',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <Steps
    title="Recommended order"
    tagline="simplified process"
    isReversed={true}
    items={[
      {
        title: 'Choose root folder',
        icon: 'tabler:number-1',
      },
      {
        title: 'Run scan or deep scan',
        icon: 'tabler:number-2',
      },
      {
        title: 'Enable What-If mode',
        icon: 'tabler:number-3',
      },
      {
        title: 'Organize by date and location',
        icon: 'tabler:number-4',
      },
      {
        title: 'Review outliers',
        icon: 'tabler:number-5',
      },
      {
        title: 'Run duplicate or merge passes',
        icon: 'tabler:number-6',
      },
      {
        title: 'Verify staged results and apply',
        icon: 'tabler:number-7',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321165247-4aa89a48be28?auto=format&fit=crop&w=1200&q=80',
      alt: 'Planning a careful cleanup workflow',
    }}
  />

  <FAQs
    title="Workflow FAQs"
    subtitle="Use these answers to decide how cautious or deep your next pass should be."
    columns={1}
    items={[
      {
        title: 'Do I need every pass for every folder?',
        description: 'No. Start with the smallest useful scope and only run heavier passes when they solve a real problem.',
      },
      {
        title: 'When should I use deep scan?',
        description: 'Use deep scan when metadata appears incomplete or when you need stronger duplicate coverage.',
      },
      {
        title: 'Should I run duplicate cleanup before organizing folders?',
        description: 'Usually no. Organize first, then review outliers, then run duplicate passes.',
      },
      {
        title: 'What should I do before permanent deletion?',
        description: 'Verify staged files, review logs, and confirm the preview matches your intent.',
      },
      {
        title: 'When should I convert HEIC to JPG?',
        description: 'Use it when sharing or downstream tools require JPG compatibility.',
      },
    ]}
  />

  <CallToAction
    title="Prefer to start small?"
    subtitle="Begin with a single year, month, or import folder, then expand once the results look right."
    actions={[
      {
        variant: 'primary',
        text: 'Read organize guide',
        href: '/blog/how-to-organize-photo-library',
      },
    ]}
  />
</Layout>

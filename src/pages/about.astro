---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About SnapAtlas',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="About SnapAtlas"
    image={{
      src: 'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1600&q=80',
      alt: 'Organized local photo archive workspace',
    }}
  >
    <Fragment slot="title">
      Built for people who want order <br />
      <span class="text-accent dark:text-white">without risking original files</span>
    </Fragment>

    <Fragment slot="subtitle">
      SnapAtlas helps clean up large local photo and video libraries with metadata-aware organization, duplicate review,
      staged cleanup, and practical workflows you can run in controlled passes.
    </Fragment>
  </Hero>

  <Stats
    title="What defines SnapAtlas"
    stats={[
      { title: 'Cloud uploads required', amount: '0' },
      { title: 'Duplicate review modes', amount: '2' },
      { title: 'Optional external tools', amount: '1' },
      { title: 'Recommended first-run steps', amount: '5' },
    ]}
  />

  <Features3
    title="What drives the product"
    subtitle="SnapAtlas favors cautious, repeatable cleanup over flashy automation."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Local-first workflow',
        description: 'Built for libraries that live on your computer or attached storage, not for mandatory cloud sync.',
        icon: 'tabler:device-desktop',
      },
      {
        title: 'Review-first safety',
        description: 'What-If mode and staged cleanup make it easier to validate changes before committing to them.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Metadata-aware organization',
        description: 'Dates, cameras, and location data help drive cleaner folder structures when files contain it.',
        icon: 'tabler:file-analytics',
      },
    ]}
  />

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Background indexing',
        description: 'Keep folder counts and library views current while scanning large archives.',
        icon: 'tabler:refresh-dot',
      },
      {
        title: 'Outlier review',
        description: 'Low-confidence files can be separated for manual review instead of forcing them through automation.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Incremental cleanup',
        description: 'Start with one year, month, or folder first, then scale up when results look right.',
        icon: 'tabler:route',
      },
      {
        title: 'Exact duplicate passes',
        description: 'Resolve highest-confidence duplicate cases before checking harder visual matches.',
        icon: 'tabler:copy',
      },
      {
        title: 'Visual duplicate passes',
        description: 'Surface edited or re-encoded versions that may still represent the same shot.',
        icon: 'tabler:photo-search',
      },
      {
        title: 'Traceable operations',
        description: 'Activity logs help explain what ran and give you a trail for verification.',
        icon: 'tabler:history',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=1600&q=80',
      alt: 'Reviewing library operations and results',
    }}
  />

  <Steps2
    title="Recommended first run"
    subtitle="SnapAtlas works best when you establish structure before heavy cleanup."
    items={[
      {
        title: 'Choose your photo root folder',
        description: 'Start at the top-level library folder so scans and recommendations cover the right scope.',
      },
      {
        title: 'Run a scan or deep scan',
        description: 'Use deep scan when you want better metadata extraction and duplicate coverage.',
      },
      {
        title: 'Enable What-If mode',
        description: 'Preview actions before changing real files.',
      },
    ]}
  />

  <Steps2
    title="Safety model"
    subtitle="The product is designed to make cleanup safer and easier to verify."
    isReversed={true}
    callToAction={{
      text: 'Read safety guide',
      href: '/blog/snapatlas-safety-and-privacy',
    }}
    items={[
      {
        title: 'What-If mode for dry runs',
        description: 'Test major operations without touching originals.',
        icon: 'tabler:search',
      },
      {
        title: 'Staging-based cleanup',
        description: 'Move cleanup candidates into reviewable staging instead of hard-deleting immediately.',
        icon: 'tabler:box-seam',
      },
      {
        title: 'Activity logs for verification',
        description: 'Check what happened after each heavy operation before moving on to the next.',
        icon: 'tabler:list-details',
      },
    ]}
  />

  <Features2
    title="Support resources"
    tagline="Read first"
    columns={4}
    items={[
      {
        title: 'Getting started',
        description: 'Set up SnapAtlas, run a scan, and sequence your first cleanup pass safely.',
      },
      {
        title: 'Troubleshooting',
        description: 'Use quick checks for missing metadata, slow operations, and duplicate threshold tuning.',
      },
      {
        title: 'FAQ',
        description: 'Answer common questions about local-only use, staged cleanup, and ExifTool.',
      },
      {
        title: 'Safety and privacy',
        description: 'Understand dry runs, staged cleanup, and why local workflows reduce exposure.',
      },
    ]}
  />
</Layout>

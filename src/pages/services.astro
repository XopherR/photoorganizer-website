---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Features',
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Features"
    title="Workflows that turn messy folders into reviewable, organized libraries"
    subtitle="SnapAtlas focuses on practical cleanup: indexing, metadata extraction, duplicate review, date and location organization, folder merges, and HEIC conversion."
    actions={[{ variant: 'primary', text: 'Read getting started', href: '/blog/getting-started-with-snapatlas' }]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'SnapAtlas features overview',
    }}
  />

  <Features2
    title="Everything SnapAtlas can do"
    subtitle="Use these tools together or in smaller passes depending on how risky the library feels."
    columns={3}
    items={[
      {
        title: 'Browse folder trees',
        description: 'Inspect folders, counts, and structure without leaving the cleanup workflow.',
        icon: 'tabler:folder',
      },
      {
        title: 'Keep views indexed',
        description: 'Background indexing helps large collections stay navigable while you work.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Extract metadata',
        description: 'Read EXIF details that support date, camera, and location-driven decisions.',
        icon: 'tabler:file-info',
      },
      {
        title: 'Find exact duplicates',
        description: 'Resolve identical copies before tackling more ambiguous look-alike results.',
        icon: 'tabler:copy-check',
      },
      {
        title: 'Find visual duplicates',
        description: 'Catch same-photo variants with different encodings, sizes, or edits.',
        icon: 'tabler:photo-search',
      },
      {
        title: 'Organize by date and location',
        description: 'Create clearer folder structures with metadata-aware grouping.',
        icon: 'tabler:calendar-pin',
      },
      {
        title: 'Review outliers',
        description: 'Keep uncertain files separate so cleanup does not force weak guesses.',
        icon: 'tabler:filter-exclamation',
      },
      {
        title: 'Merge related folders',
        description: 'Consolidate date-related or split import folders that likely belong together.',
        icon: 'tabler:folders',
      },
      {
        title: 'Convert HEIC to JPG',
        description: 'Make libraries easier to share with systems that do not support HEIC.',
        icon: 'tabler:transform',
      },
    ]}
  />

  <Content
    isReversed
    items={[
      {
        title: 'Preview with What-If mode',
        description: 'Dry-run major changes before you touch real files.',
        icon: 'tabler:shield-search',
      },
      {
        title: 'Stage removals',
        description: 'Keep cleanup candidates reviewable before permanent deletion.',
        icon: 'tabler:box-seam',
      },
      {
        title: 'Read activity logs',
        description: 'Verify what changed after each heavy operation.',
        icon: 'tabler:file-description',
      },
      {
        title: 'Run one heavy operation at a time',
        description: 'Reduce confusion and make troubleshooting easier when performance dips.',
        icon: 'tabler:route-alt-left',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1600&q=80',
      alt: 'Reviewing safe cleanup workflow',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">How SnapAtlas stays safe</h3>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Less manual browsing',
        description: 'A cleaner folder structure makes future imports and audits faster.',
        icon: 'tabler:map-search',
      },
      {
        title: 'Fewer duplicate surprises',
        description: 'Exact and visual duplicate passes help reveal both obvious and subtle copy problems.',
        icon: 'tabler:binary-tree-2',
      },
      {
        title: 'Cleaner handoff',
        description: 'JPG conversion and staged cleanup help you prepare files for sharing and archive maintenance.',
        icon: 'tabler:share',
      },
      {
        title: 'More confidence at scale',
        description: 'Incremental runs let you move from one folder to a whole archive with fewer mistakes.',
        icon: 'tabler:zoom-check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=1600&q=80',
      alt: 'Organized workspace for reviewing photo results',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">What changes after cleanup</h3>
    </Fragment>
  </Content>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Open guides',
        href: '/blog',
      },
    ]}
    title="Need step-by-step help?"
    subtitle="Use the guides for first-run setup, duplicate review, folder merges, HEIC conversion, and troubleshooting."
  />
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Support',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Support"
    title="Get unstuck while organizing your library"
    subtitle="If a scan, duplicate pass, merge, or HEIC conversion is not behaving the way you expected, start here."
    callToAction={{ text: 'Read troubleshooting', href: '/blog/troubleshooting-common-snapatlas-issues' }}
  />

  <ContactUs
    id="form"
    title="Tell us what happened"
    subtitle="Include which operation you ran, whether What-If mode was enabled, what you expected, and what happened instead."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
      {
        type: 'text',
        name: 'operation',
        label: 'Operation',
      },
      {
        type: 'text',
        name: 'scope',
        label: 'Library scope',
      },
    ]}
    textarea={{
      label: 'Details',
    }}
    disclaimer={{
      label: 'Only share file names, screenshots, or metadata you are comfortable sending.',
    }}
    description="A strong report includes scan type, folder scope, duplicate mode, and whether the issue reproduces in a smaller folder."
  />

  <Features2
    title="Fastest places to look first"
    items={[
      {
        title: 'Getting started',
        description: 'Use the recommended order: scan, What-If mode, organize, review outliers, then handle duplicates.',
      },
      {
        title: 'Troubleshooting',
        description: 'Check guidance for missing metadata, slow operations, and duplicate thresholds.',
      },
      {
        title: 'FAQ',
        description: 'Quick answers on local-only use, staged cleanup, and ExifTool requirements.',
      },
      {
        title: 'Safety and privacy',
        description: 'Understand dry runs, staged cleanup, and why local workflows reduce exposure.',
      },
      {
        title: 'Duplicate cleanup guide',
        description: 'Review exact matches first, then visual matches, then stage removals for verification.',
      },
      {
        title: 'HEIC conversion guide',
        description: 'Convert when compatibility matters, then verify JPG output and staged originals.',
      },
    ]}
  />
</Layout>

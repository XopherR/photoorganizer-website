---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'SnapAtlas Photo Organizer',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore features',
        href: '/services',
      },
      { text: 'Read getting started', href: '/blog/getting-started-with-snapatlas' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'SnapAtlas photo library workflow illustration' }}
  >
    <Fragment slot="title">
      Organize messy photo libraries with <span class="text-accent dark:text-white">safe, local-first cleanup</span>
    </Fragment>

    <Fragment slot="subtitle">
      SnapAtlas scans folders, reads metadata, finds duplicates, organizes by date and location, merges related folders,
      and converts HEIC without forcing you into a risky all-at-once workflow.
    </Fragment>
  </Hero>

  <Note title="Philosophy:" description="Local-first, review-first, and built for careful cleanup." />

  <Features
    id="features"
    tagline="Core workflows"
    title="Clean up large photo and video libraries without guesswork"
    subtitle="SnapAtlas is designed for people who need structure, duplicate review, and safer file operations instead of another generic gallery app."
    items={[
      {
        title: 'Folder browsing and indexing',
        description: 'Navigate your folder tree, view counts, and keep large library views current with background indexing.',
        icon: 'tabler:folders',
      },
      {
        title: 'Metadata extraction',
        description: 'Read EXIF metadata such as capture date, camera details, and location when files include it.',
        icon: 'tabler:camera-search',
      },
      {
        title: 'Duplicate detection',
        description: 'Review both exact duplicates and visual look-alikes, including edited copies that are not byte-for-byte identical.',
        icon: 'tabler:copy-check',
      },
      {
        title: 'Date and location organization',
        description: 'Group files into clearer date-based folders and use location metadata when available.',
        icon: 'tabler:calendar-pin',
      },
      {
        title: 'Folder merge recommendations',
        description: 'Spot related folders that likely belong together and consolidate split import batches with more confidence.',
        icon: 'tabler:folder-symlink',
      },
      {
        title: 'HEIC to JPG conversion',
        description: 'Convert HEIC and HEIF files when you need broader compatibility while keeping cleanup reviewable.',
        icon: 'tabler:arrows-exchange',
      },
    ]}
  />

  <Content
    isReversed
    tagline="Safety built in"
    title="Preview cleanup before you commit to real file changes"
    items={[
      {
        title: 'What-If mode',
        description: 'Dry-run major changes first so you can see what would happen without moving or deleting files.',
      },
      {
        title: 'Staging-based cleanup',
        description: 'Stage removals for review before anything is permanently deleted.',
      },
      {
        title: 'Activity logs',
        description: 'Review what ran, what changed, and where to look when you need to verify results.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1600&q=80',
      alt: 'Photographer reviewing library cleanup results',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Keep originals safe while you review</h3>
      SnapAtlas is built for careful cleanup, not blind bulk operations.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'Scan first',
        description: 'Start with a scan, and use a deep scan when you want fuller metadata and duplicate coverage.',
      },
      {
        title: 'Review outliers',
        description: 'When metadata is unclear, keep exceptions separate so they can be checked manually.',
      },
      {
        title: 'Run duplicate passes deliberately',
        description: 'Review exact duplicates before visual duplicates so your highest-confidence cleanup happens first.',
      },
      {
        title: 'Finish with merge or conversion tasks',
        description: 'Merge related folders and convert HEIC only after your main structure already looks right.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1486591978090-58e619d37fe7?auto=format&fit=crop&w=1600&q=80',
      alt: 'Person reviewing organized photo folders',
    }}
  >
    <Fragment slot="content">Use one steady workflow instead of juggling scripts, manual moves, and duplicate guessing.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Local file libraries',
        description: 'Built around photo and video collections that live on your computer or attached storage.',
      },
      {
        title: 'Metadata-aware grouping',
        description: 'Use dates and locations when available instead of relying only on current folder names.',
      },
      {
        title: 'Edited-copy awareness',
        description: 'Visual duplicate detection helps surface near-matches that simple hash comparison would miss.',
      },
      {
        title: 'Incremental cleanup',
        description: 'Work on a year, month, or folder at a time before scaling up across your whole archive.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=1600&q=80',
      alt: 'Large personal photo archive on a desktop setup',
    }}
  >
    <Fragment slot="content">Made for large, messy libraries from phones, cameras, exports, and scattered archive folders.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="Recommended SnapAtlas workflow"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Select your photo root folder</span>',
        description: 'Choose the top-level folder that contains your library so scans and cleanup stay scoped correctly.',
        icon: 'tabler:folder-open',
      },
      {
        title: 'Step 2: <span class="font-medium">Run a scan</span>',
        description: 'Start with a scan. Use deep scan when you want full metadata extraction and broader duplicate coverage.',
        icon: 'tabler:scan',
      },
      {
        title: 'Step 3: <span class="font-medium">Enable What-If mode</span>',
        description: 'Preview major changes before applying them to real files.',
        icon: 'tabler:shield-search',
      },
      {
        title: 'Step 4: <span class="font-medium">Organize by date and location</span>',
        description: 'Build a cleaner structure first, then review outliers that need manual attention.',
        icon: 'tabler:calendar-up',
      },
      {
        title: 'Step 5: <span class="font-medium">Review duplicates</span>',
        description: 'Check exact duplicates first, then move to visual duplicates and threshold tuning.',
        icon: 'tabler:copy-check-filled',
      },
      {
        title: 'Step 6: <span class="font-medium">Merge folders or convert HEIC</span>',
        description: 'Finish secondary cleanup tasks after your main organization pass looks correct.',
        icon: 'tabler:arrows-join',
      },
      {
        title: 'Ready',
        description: 'Verify staged results, then apply changes for real when the preview matches your intent.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?auto=format&fit=crop&w=1200&q=80',
      alt: 'Step-by-step library cleanup planning',
    }}
  />

  <Features2
    title="Built for real photo cleanup tasks"
    subtitle="SnapAtlas covers both first-pass organization and ongoing maintenance."
    tagline="Capabilities"
    items={[
      {
        title: 'Background indexing',
        description: 'Keep counts and folder state current while working through a large archive.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Exact duplicate review',
        description: 'Find byte-for-byte copies quickly before moving to harder visual comparisons.',
        icon: 'tabler:copy-check',
      },
      {
        title: 'Visual duplicate review',
        description: 'Catch same-photo variants with different encodings, crops, or edits.',
        icon: 'tabler:photo-search',
      },
      {
        title: 'Outlier handling',
        description: 'Separate unclear items so low-confidence files do not pollute automated organization.',
        icon: 'tabler:alert-circle',
      },
      {
        title: 'Date-based folders',
        description: 'Create more consistent structures such as year and day-based groupings.',
        icon: 'tabler:calendar-stats',
      },
      {
        title: 'Location grouping',
        description: 'Use GPS metadata where available to make folders easier to understand later.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Safe staging flow',
        description: 'Review cleanup candidates before anything is permanently removed.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Local-first privacy',
        description: 'No cloud upload is required for normal desktop cleanup workflows.',
        icon: 'tabler:lock',
      },
      {
        title: 'HEIC compatibility',
        description: 'Convert files when you need easier sharing with JPG-only systems.',
        icon: 'tabler:transform',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="Guides for first-time cleanup and ongoing maintenance"
    information={`Read walkthroughs for scanning, organizing by date and location, duplicate cleanup,
      related-folder merges, HEIC conversion, and SnapAtlas safety practices.`}
  />

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Use these quick answers before starting a major cleanup run."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Is SnapAtlas cloud-based?',
        description: 'No. It is a desktop workflow for local files.',
      },
      {
        title: 'Will it delete files immediately?',
        description: 'By default, cleanup is staged for review first.',
      },
      {
        title: 'Do I need ExifTool?',
        description: 'Only for writing or editing metadata. Reading metadata is built in.',
      },
      {
        title: 'Can it detect edited copies?',
        description: 'Yes. Visual duplicate detection helps surface same-photo variants.',
      },
      {
        title: 'What if duplicate results seem off?',
        description: 'Adjust the visual similarity threshold and review exact and visual duplicates separately.',
      },
      {
        title: 'What if operations feel slow?',
        description: 'Process smaller scopes first, run one heavy operation at a time, and let initial indexing finish.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'Core workflows', amount: '6' },
      { title: 'Duplicate modes', amount: '2' },
      { title: 'Cloud uploads required', amount: '0' },
      { title: 'Safety layers', amount: '3' },
    ]}
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Read guides',
        href: '/blog',
      },
    ]}
  >
    <Fragment slot="title">
      Start with <span class="sm:whitespace-nowrap">safe cleanup</span>
    </Fragment>

    <Fragment slot="subtitle">
      Scan first, preview changes, and work through your library one deliberate operation at a time.
    </Fragment>
  </CallToAction>
</Layout>
